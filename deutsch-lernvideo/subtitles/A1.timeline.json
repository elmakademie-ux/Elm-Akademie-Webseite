{
  "level": "A1",
  "lines": [
    {
      "line_id": "A1-S01-L01",
      "scene": "A1-S01",
      "speaker": "narrator",
      "text": "Hallo! Nur ein Wort. Und schon beginnt ein Gespräch.",
      "start": 0.6,
      "end": 6.953,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S01-L02",
      "scene": "A1-S01",
      "speaker": "narrator",
      "text": "Heute lernst du: Wie stelle ich mich vor?",
      "start": 7.853,
      "end": 13.5,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S02-L01",
      "scene": "A1-S02",
      "speaker": "narrator",
      "text": "Das ist Niveau A1. Du lernst einfache Wörter und kurze Sätze.",
      "start": 15.6,
      "end": 23.365,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S02-L02",
      "scene": "A1-S02",
      "speaker": "narrator",
      "text": "Wir sprechen langsam. Sprich laut mit!",
      "start": 24.265,
      "end": 28.5,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S03-L01",
      "scene": "A1-S03",
      "speaker": "mia",
      "text": "Hallo! Guten Morgen!",
      "start": 30.6,
      "end": 32.718,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S03-L02",
      "scene": "A1-S03",
      "speaker": "jonas",
      "text": "Guten Morgen!",
      "start": 33.618,
      "end": 35.029,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S03-L03",
      "scene": "A1-S03",
      "speaker": "jonas",
      "text": "Hallo!",
      "start": 35.929,
      "end": 36.729,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S04-L01",
      "scene": "A1-S04",
      "speaker": "jonas",
      "text": "Ich heiße Jonas. Und du? Wie heißt du?",
      "start": 38.829,
      "end": 44.476,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S04-L02",
      "scene": "A1-S04",
      "speaker": "mia",
      "text": "Ich heiße Mia.",
      "start": 45.376,
      "end": 47.494,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S04-L03",
      "scene": "A1-S04",
      "speaker": "jonas",
      "text": "Hallo, Mia!",
      "start": 48.394,
      "end": 49.806,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S04-L04",
      "scene": "A1-S04",
      "speaker": "mia",
      "text": "Hallo, Jonas! Freut mich!",
      "start": 50.706,
      "end": 53.529,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S04-L05",
      "scene": "A1-S04",
      "speaker": "jonas",
      "text": "Freut mich auch!",
      "start": 54.429,
      "end": 56.547,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S05-L01",
      "scene": "A1-S05",
      "speaker": "jonas",
      "text": "Woher kommst du, Mia?",
      "start": 58.647,
      "end": 61.471,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S05-L02",
      "scene": "A1-S05",
      "speaker": "mia",
      "text": "Ich komme aus Spanien. Aus Valencia.",
      "start": 62.371,
      "end": 66.606,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S05-L03",
      "scene": "A1-S05",
      "speaker": "mia",
      "text": "Und du? Woher kommst du?",
      "start": 67.506,
      "end": 71.035,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S05-L04",
      "scene": "A1-S05",
      "speaker": "jonas",
      "text": "Ich komme aus Deutschland. Aus Leipzig.",
      "start": 71.935,
      "end": 76.171,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S05-L05",
      "scene": "A1-S05",
      "speaker": "mia",
      "text": "Leipzig ist schön!",
      "start": 77.071,
      "end": 79.188,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S05-L06",
      "scene": "A1-S05",
      "speaker": "jonas",
      "text": "Valencia ist auch schön!",
      "start": 80.088,
      "end": 82.912,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S06-L01",
      "scene": "A1-S06",
      "speaker": "mia",
      "text": "Tschüss, Jonas!",
      "start": 85.012,
      "end": 86.424,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S06-L02",
      "scene": "A1-S06",
      "speaker": "jonas",
      "text": "Tschüss, Mia! Bis bald!",
      "start": 87.324,
      "end": 90.147,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S07-L01",
      "scene": "A1-S07",
      "speaker": "narrator",
      "text": "Das sind die wichtigen Wörter. Sprich nach!",
      "start": 92.247,
      "end": 97.188,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S07-L02",
      "scene": "A1-S07",
      "speaker": "mia",
      "text": "Hallo. Guten Morgen. Tschüss.",
      "start": 98.088,
      "end": 100.912,
      "estimated": true,
      "hold": 2.0
    },
    {
      "line_id": "A1-S07-L03",
      "scene": "A1-S07",
      "speaker": "jonas",
      "text": "Ich heiße. Wie heißt du?",
      "start": 103.812,
      "end": 107.341,
      "estimated": true,
      "hold": 2.0
    },
    {
      "line_id": "A1-S07-L04",
      "scene": "A1-S07",
      "speaker": "mia",
      "text": "Ich komme aus. Woher kommst du?",
      "start": 110.241,
      "end": 114.476,
      "estimated": true,
      "hold": 2.0
    },
    {
      "line_id": "A1-S07-L05",
      "scene": "A1-S07",
      "speaker": "jonas",
      "text": "Freut mich!",
      "start": 117.376,
      "end": 118.788,
      "estimated": true,
      "hold": 2.0
    },
    {
      "line_id": "A1-S08-L01",
      "scene": "A1-S08",
      "speaker": "narrator",
      "text": "Achtung: Das Verb ändert sich.",
      "start": 122.888,
      "end": 126.418,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S08-L02",
      "scene": "A1-S08",
      "speaker": "narrator",
      "text": "Ich heiße. Du heißt. Ich komme. Du kommst. Ich bin. Du bist.",
      "start": 127.318,
      "end": 135.788,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S08-L03",
      "scene": "A1-S08",
      "speaker": "narrator",
      "text": "Bei Fragen mit Fragewort steht das Verb an Position zwei: Wie heißt du? Woher kommst du?",
      "start": 136.688,
      "end": 147.982,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S09-L01",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Jetzt bist du dran! Ergänze die Sätze.",
      "start": 150.082,
      "end": 155.024,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S09-L02",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Eins: Wie … du?",
      "start": 155.924,
      "end": 158.041,
      "estimated": true,
      "hold": 2.0
    },
    {
      "line_id": "A1-S09-L03",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Richtig: Wie heißt du?",
      "start": 161.941,
      "end": 164.765,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S09-L04",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Zwei: Ich … Mia.",
      "start": 165.665,
      "end": 167.782,
      "estimated": true,
      "hold": 2.0
    },
    {
      "line_id": "A1-S09-L05",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Richtig: Ich heiße Mia.",
      "start": 171.682,
      "end": 174.506,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S09-L06",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Drei: Woher … du?",
      "start": 175.406,
      "end": 177.524,
      "estimated": true,
      "hold": 2.0
    },
    {
      "line_id": "A1-S09-L07",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Richtig: Woher kommst du?",
      "start": 181.424,
      "end": 184.247,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S09-L08",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Vier: Ich … aus Spanien.",
      "start": 185.147,
      "end": 187.971,
      "estimated": true,
      "hold": 2.0
    },
    {
      "line_id": "A1-S09-L09",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Richtig: Ich komme aus Spanien.",
      "start": 191.871,
      "end": 195.4,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S10-L01",
      "scene": "A1-S10",
      "speaker": "mia",
      "text": "Und du? Wie heißt du?",
      "start": 197.5,
      "end": 201.029,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S10-L02",
      "scene": "A1-S10",
      "speaker": "jonas",
      "text": "Woher kommst du?",
      "start": 201.929,
      "end": 204.047,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S10-L03",
      "scene": "A1-S10",
      "speaker": "narrator",
      "text": "Schreib es in die Kommentare: Ich heiße … Ich komme aus …",
      "start": 204.947,
      "end": 212.006,
      "estimated": true,
      "hold": 0.0
    },
    {
      "line_id": "A1-S10-L04",
      "scene": "A1-S10",
      "speaker": "narrator",
      "text": "Bis bald! Tschüss!",
      "start": 212.906,
      "end": 215.024,
      "estimated": true,
      "hold": 0.0
    }
  ]
}
