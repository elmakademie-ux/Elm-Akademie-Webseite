{
  "level": "A1",
  "lines": [
    {
      "line_id": "A1-S01-L01",
      "scene": "A1-S01",
      "speaker": "narrator",
      "text": "Hallo! Nur ein Wort. Und schon beginnt ein Gespräch.",
      "start": 0.6,
      "end": 4.174,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S01-L02",
      "scene": "A1-S01",
      "speaker": "narrator",
      "text": "Heute lernst du: Wie stelle ich mich vor?",
      "start": 5.074,
      "end": 8.453,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S02-L01",
      "scene": "A1-S02",
      "speaker": "narrator",
      "text": "Das ist Niveau A1. Du lernst einfache Wörter und kurze Sätze.",
      "start": 10.553,
      "end": 15.207,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S02-L02",
      "scene": "A1-S02",
      "speaker": "narrator",
      "text": "Wir sprechen langsam. Sprich laut mit!",
      "start": 16.107,
      "end": 19.121,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S03-L01",
      "scene": "A1-S03",
      "speaker": "mia",
      "text": "Hallo! Guten Morgen!",
      "start": 21.221,
      "end": 22.77,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S03-L02",
      "scene": "A1-S03",
      "speaker": "jonas",
      "text": "Guten Morgen!",
      "start": 23.67,
      "end": 24.508,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S03-L03",
      "scene": "A1-S03",
      "speaker": "jonas",
      "text": "Hallo!",
      "start": 25.408,
      "end": 25.954,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S04-L01",
      "scene": "A1-S04",
      "speaker": "jonas",
      "text": "Ich heiße Jonas. Und du? Wie heißt du?",
      "start": 28.054,
      "end": 31.628,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S04-L02",
      "scene": "A1-S04",
      "speaker": "mia",
      "text": "Ich heiße Mia.",
      "start": 32.528,
      "end": 33.873,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S04-L03",
      "scene": "A1-S04",
      "speaker": "jonas",
      "text": "Hallo, Mia!",
      "start": 34.773,
      "end": 36.046,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S04-L04",
      "scene": "A1-S04",
      "speaker": "mia",
      "text": "Hallo, Jonas! Freut mich!",
      "start": 36.946,
      "end": 38.836,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S04-L05",
      "scene": "A1-S04",
      "speaker": "jonas",
      "text": "Freut mich auch!",
      "start": 39.736,
      "end": 40.86,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S05-L01",
      "scene": "A1-S05",
      "speaker": "jonas",
      "text": "Woher kommst du, Mia?",
      "start": 42.96,
      "end": 44.812,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S05-L02",
      "scene": "A1-S05",
      "speaker": "mia",
      "text": "Ich komme aus Spanien. Aus Valencia.",
      "start": 45.712,
      "end": 48.073,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S05-L03",
      "scene": "A1-S05",
      "speaker": "mia",
      "text": "Und du? Woher kommst du?",
      "start": 48.973,
      "end": 50.926,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S05-L04",
      "scene": "A1-S05",
      "speaker": "jonas",
      "text": "Ich komme aus Deutschland. Aus Leipzig.",
      "start": 51.826,
      "end": 54.476,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S05-L05",
      "scene": "A1-S05",
      "speaker": "mia",
      "text": "Leipzig ist schön!",
      "start": 55.376,
      "end": 56.689,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S05-L06",
      "scene": "A1-S05",
      "speaker": "jonas",
      "text": "Valencia ist auch schön!",
      "start": 57.589,
      "end": 59.396,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S06-L01",
      "scene": "A1-S06",
      "speaker": "mia",
      "text": "Tschüss, Jonas!",
      "start": 61.496,
      "end": 62.35,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S06-L02",
      "scene": "A1-S06",
      "speaker": "jonas",
      "text": "Tschüss, Mia! Bis bald!",
      "start": 63.25,
      "end": 65.705,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S07-L01",
      "scene": "A1-S07",
      "speaker": "narrator",
      "text": "Das sind die wichtigen Wörter. Sprich nach!",
      "start": 67.805,
      "end": 70.644,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S07-L02",
      "scene": "A1-S07",
      "speaker": "mia",
      "text": "Hallo. Guten Morgen. Tschüss.",
      "start": 71.544,
      "end": 74.001,
      "estimated": false,
      "hold": 2.0
    },
    {
      "line_id": "A1-S07-L03",
      "scene": "A1-S07",
      "speaker": "jonas",
      "text": "Ich heiße. Wie heißt du?",
      "start": 76.901,
      "end": 79.128,
      "estimated": false,
      "hold": 2.0
    },
    {
      "line_id": "A1-S07-L04",
      "scene": "A1-S07",
      "speaker": "mia",
      "text": "Ich komme aus. Woher kommst du?",
      "start": 82.028,
      "end": 84.247,
      "estimated": false,
      "hold": 2.0
    },
    {
      "line_id": "A1-S07-L05",
      "scene": "A1-S07",
      "speaker": "jonas",
      "text": "Freut mich!",
      "start": 87.147,
      "end": 87.884,
      "estimated": false,
      "hold": 2.0
    },
    {
      "line_id": "A1-S08-L01",
      "scene": "A1-S08",
      "speaker": "narrator",
      "text": "Achtung: Das Verb ändert sich.",
      "start": 91.984,
      "end": 94.147,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S08-L02",
      "scene": "A1-S08",
      "speaker": "narrator",
      "text": "Ich heiße. Du heißt. Ich komme. Du kommst. Ich bin. Du bist.",
      "start": 95.047,
      "end": 99.74,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S08-L03",
      "scene": "A1-S08",
      "speaker": "narrator",
      "text": "Bei Fragen mit Fragewort steht das Verb an Position zwei: Wie heißt du? Woher kommst du?",
      "start": 100.64,
      "end": 106.505,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S09-L01",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Jetzt bist du dran! Ergänze die Sätze.",
      "start": 108.605,
      "end": 111.539,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S09-L02",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Eins: Wie … du?",
      "start": 112.439,
      "end": 113.327,
      "estimated": false,
      "hold": 2.0
    },
    {
      "line_id": "A1-S09-L03",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Richtig: Wie heißt du?",
      "start": 117.227,
      "end": 118.946,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S09-L04",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Zwei: Ich … Mia.",
      "start": 119.846,
      "end": 121.43,
      "estimated": false,
      "hold": 2.0
    },
    {
      "line_id": "A1-S09-L05",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Richtig: Ich heiße Mia.",
      "start": 125.33,
      "end": 127.465,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S09-L06",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Drei: Woher … du?",
      "start": 128.365,
      "end": 130.01,
      "estimated": false,
      "hold": 2.0
    },
    {
      "line_id": "A1-S09-L07",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Richtig: Woher kommst du?",
      "start": 133.91,
      "end": 135.666,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S09-L08",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Vier: Ich … aus Spanien.",
      "start": 136.566,
      "end": 138.078,
      "estimated": false,
      "hold": 2.0
    },
    {
      "line_id": "A1-S09-L09",
      "scene": "A1-S09",
      "speaker": "narrator",
      "text": "Richtig: Ich komme aus Spanien.",
      "start": 141.978,
      "end": 144.213,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S10-L01",
      "scene": "A1-S10",
      "speaker": "mia",
      "text": "Und du? Wie heißt du?",
      "start": 146.313,
      "end": 148.266,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S10-L02",
      "scene": "A1-S10",
      "speaker": "jonas",
      "text": "Woher kommst du?",
      "start": 149.166,
      "end": 150.177,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S10-L03",
      "scene": "A1-S10",
      "speaker": "narrator",
      "text": "Schreib es in die Kommentare: Ich heiße … Ich komme aus …",
      "start": 151.077,
      "end": 155.283,
      "estimated": false,
      "hold": 0.0
    },
    {
      "line_id": "A1-S10-L04",
      "scene": "A1-S10",
      "speaker": "narrator",
      "text": "Bis bald! Tschüss!",
      "start": 156.183,
      "end": 157.676,
      "estimated": false,
      "hold": 0.0
    }
  ]
}
